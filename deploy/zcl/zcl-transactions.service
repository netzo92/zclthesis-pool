[Unit]
Description=Publish bounded public Zclassic transaction observations
After=zclassic.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/zcl-transactions/publish-transactions.py
TimeoutStartSec=90
Nice=10
CPUQuota=20%
MemoryMax=128M
UMask=0077
StateDirectory=zcl-transactions
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/zcl-transactions /var/lib/zcl-public

