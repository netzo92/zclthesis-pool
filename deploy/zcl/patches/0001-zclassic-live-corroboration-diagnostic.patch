+LiveCorroborationInfo GetLiveCorroborationInfo()
+{
+    AssertLockHeld(cs_main);
+    LiveCorroborationInfo info = {false, uint256(), -1, -1, -1, -1, std::string()};
+    const CBlockIndex* tip = chainActive.Tip();
+    if (tip != NULL) {
+        info.tipHash = tip->GetBlockHash();
+        info.tipHeight = tip->nHeight;
+    }
+    const int64_t depth = GetArg("-maxreorgdepth", DEFAULT_MAX_REORG_DEPTH);
+    const int64_t peers = std::max(GetArg("-finalizationminpeers",
+                                        DEFAULT_FINALIZATION_MIN_PEERS), int64_t(1));
+    if (depth <= 0 || depth > std::numeric_limits<int>::max() ||
+        peers > std::numeric_limits<int>::max()) {
+        info.reason = "live corroboration requires a positive bounded depth and peer count";
+        return info;
+    }
+    info.requiredDepth = static_cast<int>(depth);
+    info.requiredPeers = static_cast<int>(peers);
+    if (tip == NULL || tip->nHeight < info.requiredDepth) {
+        info.reason = "no active candidate at the required depth";
+        return info;
+    }
+    const CBlockIndex* candidate = tip->GetAncestor(tip->nHeight - info.requiredDepth);
+    info.candidateHeight = candidate->nHeight;
+    if (BootstrapValidationHoldsFinalization()) {
+        info.reason = "bootstrap validation or imported-tip corroboration is pending";
+        return info;
+    }
+    // Reuse every production check: IBD, active ancestry, a header received live
+    // this session, independent outbound groups, and the higher-work fork veto.
+    // Do not consult or write g_finalizationHeld, call FindBlockToFinalize, or
+    // alter pindexFinalized. A later peer announcement can change this answer
+    // without connecting another block or changing finalization policy.
+    info.ready = LiveNetworkCorroboratesTip(candidate, info.requiredDepth,
+                                           info.requiredPeers, info.reason);
+    return info;
+}
