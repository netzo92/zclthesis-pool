+BOOST_AUTO_TEST_CASE(live_corroboration_tracks_peers_without_new_block)
+{
+    std::vector<CBlockIndex> chain;
+    BuildChain(chain, 131);
+    const CBlockIndex* tip = &chain[130];
+    const CBlockIndex* candidate = &chain[120];
+    const int64_t startup = 1000;
+    std::vector<PeerTipView> peers;
+    peers.push_back(Peer(tip, false, 1));
+    peers.push_back(Peer(&chain[129], false, 2));
+    std::string why;
+    const auto ready = [&]() {
+        return EvaluateTipCorroboration(candidate, false, true, tip,
+            startup + 5, startup, 10, 2, peers, why);
+    };
+    // First peer's block has connected; another peer still announces its parent.
+    // This is the former cached1/2 state. The chain and candidate never change.
+    BOOST_CHECK(!ready());
+    BOOST_CHECK(why.find("only 1 independent outbound") != std::string::npos);
+    peers[1].bestKnown = tip; // later announcement, with NO new connected block
+    BOOST_CHECK(ready());
+    BOOST_CHECK_EQUAL(tip->nHeight, 130);
+    BOOST_CHECK_EQUAL(candidate->nHeight, 120);
+
+    // Readiness must also close again when corroboration is lost. No cached
+    // successful check, inbound peer or duplicate group can keep it open.
+    peers[1].bestKnown = NULL;
+    BOOST_CHECK(!ready());
+    peers[1].bestKnown = tip;
+    peers[1].fInbound = true;
+    BOOST_CHECK(!ready());
+    peers[1].fInbound = false;
+    peers[1].group = peers[0].group;
+    BOOST_CHECK(!ready());
+    peers[1].group.assign(1, 2);
+    BOOST_CHECK(ready());
+
+    // Even after a successful observation, a new inbound announcement of a
+    // higher-work fork below the candidate must veto the live result.
+    std::vector<CBlockIndex> fork;
+    BuildChain(fork, 100, &chain[50]);
+    fork.back().nChainWork = arith_uint256(10000);
+    peers.push_back(Peer(&fork.back(), true, 3));
+    BOOST_CHECK(!ready());
+    BOOST_CHECK(why.find("forks below") != std::string::npos);
+    peers.pop_back();
+    BOOST_CHECK(ready());
+}
+
+BOOST_AUTO_TEST_CASE(live_corroboration_does_not_mutate_finalization)
+{
+    LOCK(cs_main);
+    bool heldBefore; int heightBefore; std::string reasonBefore; int64_t sinceBefore;
+    GetFinalizationHoldInfo(heldBefore, heightBefore, reasonBefore, sinceBefore);
+    const CBlockIndex* finalizedBefore = GetFinalizedBlock();
+    const CBlockIndex* tipBefore = chainActive.Tip();
+    const LiveCorroborationInfo live = GetLiveCorroborationInfo();
+    // The ordinary test fixture has no independently corroborating network.
+    BOOST_CHECK(!live.ready);
+    BOOST_CHECK_EQUAL(live.tipHeight, tipBefore ? tipBefore->nHeight : -1);
+    BOOST_CHECK(live.tipHash == (tipBefore ? tipBefore->GetBlockHash() : uint256()));
+    bool heldAfter; int heightAfter; std::string reasonAfter; int64_t sinceAfter;
+    GetFinalizationHoldInfo(heldAfter, heightAfter, reasonAfter, sinceAfter);
+    BOOST_CHECK_EQUAL(heldAfter, heldBefore);
+    BOOST_CHECK_EQUAL(heightAfter, heightBefore);
+    BOOST_CHECK_EQUAL(reasonAfter, reasonBefore);
+    BOOST_CHECK_EQUAL(sinceAfter, sinceBefore);
+    BOOST_CHECK(GetFinalizedBlock() == finalizedBefore);
+    BOOST_CHECK(chainActive.Tip() == tipBefore);
+}
