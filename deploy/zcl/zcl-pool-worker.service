[Unit]
Description=ZCL-only block and earnings pipeline
After=zcl-rpc-cookie.service mariadb.service zclassic.service
Requires=mariadb.service zclassic.service

[Service]
Type=oneshot
User=zclpool
Group=zclpool
UMask=0007
WorkingDirectory=/opt/zcl-pool/source/yiimp2
ExecStart=/usr/bin/php yii zcl-worker/tick
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/yiimp /opt/zcl-pool/source/yiimp2/runtime

