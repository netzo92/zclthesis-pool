[Unit]
Description=Publish allowlisted ZCL pool readiness
After=mariadb.service zclassic.service

[Service]
Type=oneshot
User=root
UMask=0022
ExecStart=/usr/bin/python3 /opt/zcl-pool/source/deploy/zcl/publish-pool-status.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zcl-public /var/log/yiimp /opt/zcl-pool/source/yiimp2/runtime
