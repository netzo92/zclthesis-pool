pool.zclthesis.com {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Content-Security-Policy "default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' wss://pool.zclthesis.com; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  }
  @analyticsEvent {
    method POST
    path /api/analytics/event
  }
  handle @analyticsEvent {
    request_body {
      max_size 2KB
    }
    rewrite * /event
    reverse_proxy 127.0.0.1:8792
  }
  @read method GET HEAD
  handle @read {
    handle /ws {
      reverse_proxy 127.0.0.1:8787 {
        header_up X-Forwarded-For {http.request.remote.host}
      }
    }
    @minerSource path /mine/src/miner-worker.mjs /mine/src/protocol.mjs /mine/src/solver.mjs /mine/src/solver-reference.mjs /mine/src/solver-shaders.mjs
    handle @minerSource {
      uri strip_prefix /mine
      root * /opt/zcl-pool/webminer
      file_server
    }
    @minerPage path /mine/ /mine/index.html /mine/es/ /mine/es/index.html /mine/style.css /mine/app.mjs
    handle @minerPage {
      uri strip_prefix /mine
      root * /opt/zcl-pool/webminer/public
      file_server
    }
    @api path /api/node.json /api/pool.json /api/richlist/zcl.json
    handle @api {
      root * /var/lib/zcl-public
      header Cache-Control "public, max-age=30"
      file_server
    }
    @static path / /index.html /es/ /es/index.html /style.css /status.js
    handle @static {
      root * /opt/zcl-pool/source/deploy/zcl/public
      file_server
    }
    respond 404
  }
  respond 405
}

# Accessible only through the operator's authenticated IAP SSH tunnel.
http://127.0.0.1:8090 {
  bind 127.0.0.1
  root * /opt/zcl-pool/source/yiimp2/web
  php_fastcgi unix//run/php/php8.3-fpm.sock
  file_server
  header X-Content-Type-Options nosniff
  header Cache-Control no-store
}
