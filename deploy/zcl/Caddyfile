pool.zclthesis.com {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  }
  @read method GET HEAD
  handle @read {
    @api path /api/node.json /api/pool.json /api/richlist/zcl.json
    handle @api {
      root * /var/lib/zcl-public
      header Cache-Control "public, max-age=30"
      file_server
    }
    @static path / /index.html /es/ /es/index.html /style.css /status.js
    handle @static {
      root * /opt/zcl-pool/source/deploy/zcl/public
      file_server
    }
    respond 404
  }
  respond 405
}

# Accessible only through the operator's authenticated IAP SSH tunnel.
http://127.0.0.1:8090 {
  root * /opt/zcl-pool/source/yiimp2/web
  php_fastcgi unix//run/php/php8.3-fpm.sock
  file_server
  header X-Content-Type-Options nosniff
  header Cache-Control no-store
}
