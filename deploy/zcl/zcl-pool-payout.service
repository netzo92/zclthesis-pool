[Unit]
Description=Dedicated durable ZCL payout coordinator
After=zcl-rpc-cookie.service zcl-pool-worker.service mariadb.service zclassic.service
Requires=mariadb.service zclassic.service

[Service]
Type=oneshot
User=zclpool
Group=zclpool
UMask=0007
WorkingDirectory=/opt/zcl-pool/source/yiimp2
ExecStart=/usr/bin/php yii zcl-worker/payout
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/yiimp /opt/zcl-pool/source/yiimp2/runtime

